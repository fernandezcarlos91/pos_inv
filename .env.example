# =============================================================================
# POS - Variables de Entorno de Configuración y Producción
# =============================================================================

# Entorno de ASP.NET Core (Production o Development)
ASPNETCORE_ENVIRONMENT=Production

# -----------------------------------------------------------------------------
# Base de Datos PostgreSQL
# -----------------------------------------------------------------------------
# Opción A (Formato estándar Npgsql / Docker):
ConnectionStrings__DefaultConnection=Host=pos-postgres;Port=5432;Database=pos_inv;Username=pos_user;Password=tu_contrasena_segura

# Opción B (Formato Render / Cloud URL):
# DATABASE_URL=postgres://pos_user:tu_contrasena_segura@dpg-xxx.render.com/pos_inv

# -----------------------------------------------------------------------------
# JWT (Seguridad y Autenticación)
# -----------------------------------------------------------------------------
# Clave criptográfica secreta de mínimo 32 caracteres (256 bits) para firma HMAC-SHA256
JwtSettings__SecretKey=reemplazar_con_clave_secreta_de_al_menos_32_caracteres_aleatorios
JwtSettings__Issuer=PosBackend
JwtSettings__Audience=PosClient
JwtSettings__ExpiryMinutes=1440

# -----------------------------------------------------------------------------
# CORS (Orígenes Permitidos)
# -----------------------------------------------------------------------------
# Orígenes web autorizados para consultar la API (separados por coma si hay varios)
# Ejemplo para hosting en Render con frontend y dominio propio:
Cors__AllowedOrigins=https://pos-inv-web.onrender.com,https://tu-dominio.com

# -----------------------------------------------------------------------------
# Frontend (Vite) - Solo si se compila con URL de backend externa
# -----------------------------------------------------------------------------
# VITE_API_BASE_URL=https://pos-inv-api.onrender.com/api

